# BPI-R4 (MediaTek MT7988A, filogic) — 官方 25.12 树自带支持（kernel 6.12.94，与 rockchip 相同）
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r4=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
## BPI-R4 专属应用（轻量，保留在最小固件）
CONFIG_PACKAGE_luci-app-fan-bpir4=y
CONFIG_PACKAGE_luci-app-sfpmon=y
CONFIG_PACKAGE_luci-app-mtk-wed=y
## Wi-Fi：本板无无线子卡（BPI-R4 的 Wi-Fi 为 M.2 E-key 槽选配），不装驱动/固件省 rootfs；
## 若日后插入 MT7915 子卡：opkg install kmod-mt7915e kmod-mt7915-firmware wpad-openssl 即可
# 说明：BPI-R4 最小核心。不含任何代理/重依赖（无 dae/fchomo/passwall/ssr-plus/homeproxy/
# /opt 自动分区 + 三专属应用。完整版见 config.seed。
# RNGD（BPI-R4 不用 LRNG——MT7988A 实测 LRNG 开机挂死，回归默认 urngd+urandom-seed 方案）
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y
# /opt 自动分区所需: fstab/block 体系 + ext4 工具

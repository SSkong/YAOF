# BPI-R4 (MediaTek MT7988A, filogic) — 官方 25.12 树自带支持（kernel 6.12.94，与 rockchip 相同）
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r4=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
# ARM 专属（原在公共体，X86 加入后下沉；panfrost 对 MT7988 无实际用途，为保持既有固件一致暂留）
CONFIG_PACKAGE_autocore-arm=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-drm-panfrost=y
CONFIG_PACKAGE_kmod-multimedia-input=y
CONFIG_PACKAGE_kmod-backlight-pwm=y
## BPI-R4 专属应用
CONFIG_PACKAGE_luci-app-fan-bpir4=y
CONFIG_PACKAGE_luci-app-sfpmon=y
CONFIG_PACKAGE_luci-app-mtk-wed=y
## Wi-Fi：本板无无线子卡（BPI-R4 的 Wi-Fi 为 M.2 E-key 槽选配），不装驱动/固件省 rootfs；
## 若日后插入 MT7915 子卡：opkg install kmod-mt7915e kmod-mt7915-firmware wpad-openssl 即可
## 关闭 recovery initramfs（recovery.itb 会把整个 rootfs 打进 44MB 检查的分区，
## full seed 下必超尺寸：sdcard.img "too big: 216M > 44M" 编译失败）；首启自动分区不依赖它
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# RNGD（BPI-R4 不用 LRNG——MT7988A 实测 LRNG 开机挂死，回归默认 urngd+urandom-seed 方案）
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y
